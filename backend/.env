# NestPress Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# JWT Configuration (defaults provided for development)
JWT_SECRET=nestpress-dev-secret-key-change-in-production-32chars
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=nestpress-dev-refresh-secret-change-in-prod-32char
JWT_REFRESH_EXPIRATION=7d

# Database Provider (firebase | mongodb | dynamodb | supabase)
# MongoDB is recommended for local development
DATABASE_PROVIDER=mongodb

# Firebase Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/nestpress

# DynamoDB Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_ENDPOINT=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider (gemini | openai | anthropic | none)
# Set to 'none' to disable AI features
AI_PROVIDER=none

# Google Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Payment Provider (stripe | paypal | square | none)
# Set to 'none' to disable payment processing
PAYMENT_PROVIDER=none

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Square
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Media Storage
MEDIA_UPLOAD_PATH=./uploads
MEDIA_MAX_SIZE=10485760

# Seed demo data on startup (true | false)
SEED_DATA=true